rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for provisioning scripts
    match /scripts/{file} {
      allow read: if true;
      allow write: if false;
    }
    // Admin can read/write everything
    match /{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == "anivanis@gmail.com";
    }
    // Authenticated users can upload their own job inputs
    match /inputs/{fileName} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    // Authenticated users can download outputs
    match /outputs/{fileName} {
      allow read: if request.auth != null;
    }
  }
}
